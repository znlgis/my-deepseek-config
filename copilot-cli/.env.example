# GitHub Copilot CLI × DeepSeek（BYOK / 自带密钥）环境变量示例
# Copilot CLI 支持 BYOK 自定义模型。DeepSeek 推荐用 Anthropic 兼容端点接入。
# 切勿把真实 API Key 提交进仓库；用后可 `unset` 或写入 shell 启动文件。

# 提供方类型：openai | azure | anthropic —— DeepSeek 走 anthropic
COPILOT_PROVIDER_TYPE=anthropic
# DeepSeek 的 Anthropic 兼容端点
COPILOT_PROVIDER_BASE_URL=https://api.deepseek.com/anthropic
# DeepSeek API Key（https://platform.deepseek.com 申请）
COPILOT_PROVIDER_API_KEY=sk-your-deepseek-key
# 主模型（Pro / 强推理）：deepseek-v4-pro；轻量：deepseek-v4-flash
COPILOT_MODEL=deepseek-v4-pro

# DeepSeek 不在 Copilot 默认模型目录内，按需声明 token 上限：
COPILOT_PROVIDER_MAX_PROMPT_TOKENS=840000
COPILOT_PROVIDER_MAX_OUTPUT_TOKENS=128000

# 可选：仅连模型提供方、跳过与 GitHub 的非必要通信
# COPILOT_OFFLINE=true
