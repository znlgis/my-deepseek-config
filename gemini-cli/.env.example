# Gemini CLI × DeepSeek 环境变量示例
#
# ⚠️ 上游 google-gemini/gemini-cli 仅支持 Google 后端，无法直连 DeepSeek。
# 要在 Gemini CLI 风格的终端里用 DeepSeek，二选一：
#   1) 使用支持多 Provider 的分支（如 llxprt-code），或经 LiteLLM 等代理把
#      DeepSeek 暴露为 OpenAI 兼容端点，再用下面的 OPENAI_* 变量指向该端点/分支；
#   2) 直接改用同为 Gemini CLI 家族、原生支持 DeepSeek 的 Qwen Code / iFlow CLI。
#
# 切勿把真实 API Key 提交进仓库。

# DeepSeek（或代理）的 OpenAI 兼容端点
OPENAI_BASE_URL=https://api.deepseek.com/v1

# DeepSeek API Key（https://platform.deepseek.com 申请）
OPENAI_API_KEY=sk-your-deepseek-key

# 主模型 deepseek-v4-pro（Pro）/ 轻量模型 deepseek-v4-flash（Flash）
OPENAI_MODEL=deepseek-v4-flash

# 使用官方 Gemini 模型时改用 Google 的 API Key：
# GEMINI_API_KEY=your-google-gemini-api-key
